# Dependencies
node_modules/

# Environment files (keep templates in version control)
.env
.env.*
!.env.example
!**/.env.example

# Build and framework output
dist/
.next/
.next-dev/
*.tsbuildinfo
.turbo/
packages/db/src/generated/

# Test output
coverage/
apps/web/test-results/
apps/web/playwright-report/

# Local databases
**/prisma/*.db
**/prisma/*.db-journal

# pnpm workspaces use the root lockfile; ignore accidental package-level lockfiles
**/pnpm-lock.yaml
!/pnpm-lock.yaml

# Logs
*.log
pnpm-debug.log*

# OS and local tool settings
.DS_Store
.claude/settings.local.json

.reviews

# SoundHub Ralph runtime state
.ralph/state/*
!.ralph/state/.gitkeep