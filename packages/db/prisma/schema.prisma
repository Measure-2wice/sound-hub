// SoundHub Milestone 1 foundation schema.
//
// This is the complete structural foundation for issues #2 through #8. It
// replaces the pre-release Role/ProducerProfile/MusicTrack scaffold. The
// closed behavior states are modeled as Prisma enums (see `enum` declarations
// below); the extensible taxonomies (ServiceCategory, Specialty, PricingUnit)
// are seeded records with stable `key` columns and are not enums. Public DTOs
// never expose raw Prisma models.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated"
  // `partialIndexes` enables the `where:` predicate on @@index /
  // @@unique declarations. BG4 created the partial unique index
  // `project_requests_pending_unique_idx` in
  // 20260827090000_bg4_project_requests/migration.sql; declaring it
  // here keeps future migration diffs from treating the SQL-created
  // index as unexplained drift and prevents `prisma migrate dev`
  // from generating a duplicate CREATE INDEX statement.
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ---------- Closed behavior states (Prisma enums) ----------

enum WorkspaceType {
  Personal
  Organization
}

enum WorkspaceStatus {
  Active
  Suspended
}

enum WorkspaceMembershipRole {
  Owner
  Admin
  Member
}

enum MarketplaceCapability {
  Buyer
  Seller
}

enum SellerProfileStatus {
  Draft
  Published
  Suspended
}

enum ServiceOfferingStatus {
  Draft
  Active
  Paused
  Archived
}

enum ServiceMode {
  Remote
  InPerson
  Hybrid
}

enum PricingKind {
  StartingAt
  Fixed
  ContactForQuote
}

enum PurchaseMode {
  BundleOnly
}

// Audio sample cleanup lifecycle.
//
//   - `Live`           — visible in buyer-facing discovery; default.
//   - `PendingCleanup` — the seller removed the sample but the
//     storage object could not be deleted (e.g. provider outage).
//     The row is preserved so a bounded retry can complete the
//     bounded object cleanup later. Hidden from buyer-facing
//     discovery immediately.
//   - `Removed`        — the storage object has been removed; the
//     row will be deleted at the next transactional sweep.
enum AudioSampleCleanupStatus {
  Live
  PendingCleanup
  Removed
}

enum ProjectRequestStatus {
  // Seller has not yet responded.
  Pending
  // Seller explicitly accepted; a Negotiating Deal was atomically
  // created. Terminal.
  Accepted
  // Seller explicitly declined. No Deal was created. Terminal.
  Declined
}

enum DealStatus {
  // The seller accepted the ProjectRequest but the parties have not
  // yet both approved a TermsVersion and the buyer has not initiated
  // funding. The Deal can transition to Active only via the
  // deterministic activation invariant owned by a later ticket.
  Negotiating
  // Both parties have approved the same current TermsVersion and
  // the buyer's sandbox funding for that version has been confirmed.
  // Owned by a later ticket; never set in BG4.
  Active
}

// ---------- Identity and authority ----------

model UserAccount {
  id        String   @id @default(cuid())
  // The primary email associated with the account. Owned by SoundHub for
  // display and notification purposes; provider-owned identities live in
  // the IdentityProvider mapping table so a provider change does not
  // rewrite this column. Nullable because the Buildathon Golden Slice
  // introduces identity-only accounts (a user may sign in via a managed
  // provider without SoundHub ever having been told an email).
  email     String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships             WorkspaceMembership[]
  ownedWorkspaces         Workspace[]           @relation("WorkspaceOwner")
  identityProviders       IdentityProvider[]
  authSessions            AuthSession[]
  // Briefs the human authored as the buyer-side actor (BG3).
  authoredBriefs          ProjectBrief[]        @relation("BriefCreatedByUser")
  // BG4 ProjectRequests. Two relations: the buyer-side creator and
  // the seller-side decision actor. A NULL sellerDecisionByUserId
  // means the request is still Pending.
  authoredProjectRequests ProjectRequest[]      @relation("ProjectRequestCreatedBy")
  decidedProjectRequests  ProjectRequest[]      @relation("ProjectRequestDecidedBy")

  @@map("user_accounts")
}

// IdentityProvider maps a managed provider's subject identifier to a
// durable SoundHub UserAccount. The (provider, subject) tuple is unique
// so the same provider subject cannot accidentally create duplicate
// accounts on repeat sign-in. Provider subjects, claims, roles, and
// metadata never identify or authorize a Workspace; they only resolve
// to a UserAccount. See ADR 0004 (External authentication proves login
// only) for the architectural split.
model IdentityProvider {
  id            String   @id @default(cuid())
  // Stable provider key, e.g. "managed-magic-link" or "deterministic".
  provider      String
  // The provider's unique identifier for this human. Opaque to
  // SoundHub; never exposed in public DTOs.
  subject       String
  // The email the provider knows the user by, when applicable. Optional
  // because some provider configurations do not surface email.
  providerEmail String?
  userAccountId String
  createdAt     DateTime @default(now())

  userAccount UserAccount @relation(fields: [userAccountId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@index([userAccountId])
  @@map("identity_providers")
}

// AuthSession is a server-issued, opaque session handle. The browser
// receives the id as an HttpOnly cookie; the server resolves it back
// to the authenticated UserAccount on every protected request. The
// client cannot assert an arbitrary UserAccount because the session
// id is the only authoritative identity signal. Revocation is recorded
// rather than deleted so audit evidence survives the lifetime of the
// session.
model AuthSession {
  id            String    @id @default(cuid())
  userAccountId String
  createdAt     DateTime  @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?

  userAccount UserAccount @relation(fields: [userAccountId], references: [id], onDelete: Cascade)

  @@index([userAccountId])
  @@map("auth_sessions")
}

model Workspace {
  id          String          @id @default(cuid())
  slug        String          @unique
  name        String
  type        WorkspaceType
  status      WorkspaceStatus @default(Active)
  ownerUserId String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  owner                 UserAccount           @relation("WorkspaceOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  memberships           WorkspaceMembership[]
  capabilities          WorkspaceCapability[]
  sellerProfile         SellerProfile?
  // Briefs authored under this Workspace as the buyer (BG3). A
  // Workspace must hold the Buyer capability at brief-creation time.
  buyerBriefs           ProjectBrief[]        @relation("BuyerWorkspaceBriefs")
  // BG4 ProjectRequests referencing this Workspace as either side.
  // The buyer side is gated on the Buyer capability at create time;
  // the seller side is gated on the Seller capability (and a
  // matching SellerProfile / ServiceOffering ownership) at create
  // time and on current WorkspaceMembership at accept/decline time.
  buyerProjectRequests  ProjectRequest[]      @relation("BuyerWorkspaceProjectRequests")
  sellerProjectRequests ProjectRequest[]      @relation("SellerWorkspaceProjectRequests")
  // BG4 Deals referencing this Workspace as either side. The
  // accepted ProjectRequest's buyer/seller workspaces are copied
  // onto the Deal so authorization can revalidate them without
  // joining through ProjectRequest.
  buyerDeals            Deal[]                @relation("BuyerWorkspaceDeals")
  sellerDeals           Deal[]                @relation("SellerWorkspaceDeals")

  @@map("workspaces")
}

model WorkspaceMembership {
  id          String                  @id @default(cuid())
  userId      String
  workspaceId String
  role        WorkspaceMembershipRole
  createdAt   DateTime                @default(now())

  user      UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@map("workspace_memberships")
}

model WorkspaceCapability {
  id          String                @id @default(cuid())
  workspaceId String
  capability  MarketplaceCapability

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, capability])
  @@map("workspace_capabilities")
}

// ---------- Seller discovery ----------

model SellerProfile {
  id                 String              @id @default(cuid())
  workspaceId        String              @unique
  professionalName   String
  bio                String
  status             SellerProfileStatus @default(Draft)
  basedInCity        String?
  basedInRegion      String?
  basedInCountryCode String
  avatarUrl          String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  workspace             Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  specialties           SellerProfileSpecialty[]
  caribbeanAffiliations CaribbeanAffiliation[]
  offerings             ServiceOffering[]

  @@map("seller_profiles")
}

model Specialty {
  id   String @id @default(cuid())
  key  String @unique
  name String

  profiles SellerProfileSpecialty[]

  @@map("specialties")
}

model SellerProfileSpecialty {
  sellerProfileId String
  specialtyId     String

  sellerProfile SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)
  specialty     Specialty     @relation(fields: [specialtyId], references: [id], onDelete: Restrict)

  @@id([sellerProfileId, specialtyId])
  @@map("seller_profile_specialties")
}

model CaribbeanAffiliation {
  id              String @id @default(cuid())
  sellerProfileId String
  countryCode     String

  sellerProfile SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)

  @@unique([sellerProfileId, countryCode])
  @@index([countryCode])
  @@map("caribbean_affiliations")
}

// ---------- Extensible taxonomies ----------

model ServiceCategory {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  // `bundleOnly` is reserved for categories that are only purchasable as part
  // of an offering bundle. The 10 initial approved categories are all
  // independently purchasable (bundleOnly = false).
  bundleOnly  Boolean  @default(false)
  createdAt   DateTime @default(now())

  primaryOfferings         ServiceOffering[] @relation("PrimaryCategory")
  includedServiceOfferings IncludedService[]

  @@map("service_categories")
}

model PricingUnit {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  createdAt DateTime @default(now())

  pricingOptions ServiceOfferingPricing[]

  @@map("pricing_units")
}

// ---------- Service offerings ----------

model ServiceOffering {
  id                String                @id @default(cuid())
  slug              String                @unique
  sellerProfileId   String
  title             String
  description       String
  status            ServiceOfferingStatus @default(Draft)
  serviceMode       ServiceMode
  primaryCategoryId String
  genreTags         String[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  sellerProfile        SellerProfile                @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)
  primaryCategory      ServiceCategory              @relation("PrimaryCategory", fields: [primaryCategoryId], references: [id], onDelete: Restrict)
  includedServices     IncludedService[]
  serviceAreas         ServiceOfferingServiceArea[]
  pricing              ServiceOfferingPricing?
  audioSamples         ServiceOfferingAudioSample[]
  orphanedAudioStorage AudioSampleOrphanedStorage[]
  // BG4 references: a ServiceOffering can be selected by many
  // ProjectRequests over time and become the basis for many Deals.
  // RESTRICT on delete prevents an offering from being removed
  // while it is referenced.
  projectRequests      ProjectRequest[]
  deals                Deal[]

  @@index([sellerProfileId])
  @@index([primaryCategoryId])
  @@index([status])
  @@map("service_offerings")
}

model IncludedService {
  id           String       @id @default(cuid())
  offeringId   String
  categoryId   String
  purchaseMode PurchaseMode

  offering ServiceOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  category ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([offeringId, categoryId])
  @@map("included_services")
}

model ServiceOfferingServiceArea {
  id          String  @id @default(cuid())
  offeringId  String
  city        String?
  region      String?
  countryCode String

  offering ServiceOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  @@index([offeringId])
  @@index([countryCode])
  @@map("offering_service_areas")
}

model ServiceOfferingPricing {
  id          String      @id @default(cuid())
  offeringId  String      @unique
  kind        PricingKind
  amountMinor Int?
  currency    String?
  unitId      String?

  offering ServiceOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  unit     PricingUnit?    @relation(fields: [unitId], references: [id], onDelete: Restrict)

  @@map("offering_pricing")
}

// ---------- ProjectBrief (Buildathon Golden Slice 3) ----------
//
// A Workspace-owned record of the buyer's natural-language creative
// need. Created under an explicitly acting Buyer-capable Workspace
// (per GS 4 / GS 6). Carries the verbatim original text, the
// validated required constraints and preferences produced by the
// Matchmaker AI boundary (with provenance: AI provider key + model
// id + fallback flag), and the non-search project requirements that
// are useful downstream but never influence eligibility. The Brief is
// immutable: once persisted it is the source of truth for what the
// buyer asked. Any change creates a new Brief row; we never mutate an
// existing one in place. This makes the ProjectRequest revalidation
// step trivially safe (the buyer's intended criteria cannot drift
// after persistence).
model ProjectBrief {
  id                        String   @id @default(cuid())
  buyerWorkspaceId          String
  // The acting human who authored the brief. Recorded for audit; not
  // an authorization signal (Workspace membership is).
  createdByUserId           String
  // The verbatim text the buyer submitted (trimmed + collapsed; full
  // normalisation rules live in @soundhub/types).
  originalText              String
  // Validated required criteria, JSON-encoded per the shared Zod
  // TalentSearchRequiredCriteriaV1 schema. Required constraints may
  // never be silently relaxed by AI or fallback behaviour.
  requiredCriteriaJson      Json
  // Normalised buyer query (per normalizedQuerySchema). Persisted
  // alongside the required/preferred axes so a brief whose criteria
  // surface only a query (e.g. the deterministic fallback when the
  // buyer named no recognised category / location / mode) round-
  // trips through the schema without dropping the axis.
  criteriaQueryJson         Json?
  // Validated preferred criteria (may be absent when the buyer did
  // not express any preference signal).
  preferredCriteriaJson     Json?
  // Non-search project requirements (e.g. funding deadline, scope
  // hints captured by the brief). Persisted as a free-form JSON
  // blob so the brief can carry whatever the buyer asked without
  // being forced to extend the search contract. NOT consumed by the
  // TalentSearchService.
  nonSearchRequirementsJson Json?
  // Provenance: which AI adapter produced the validated criteria
  // (managed or deterministic-fallback) and the adapter-supplied
  // model id (null for the deterministic fallback). Recorded so the
  // UI can disclose provenance and so audits can prove which path
  // produced the result. `aiFallbackUsed: true` means the
  // deterministic fallback crossed the same validation +
  // TalentSearchService boundary (per the BG3 ticket).
  aiProvider                String
  aiModelId                 String?
  aiFallbackUsed            Boolean
  createdAt                 DateTime @default(now())

  buyerWorkspace  Workspace           @relation("BuyerWorkspaceBriefs", fields: [buyerWorkspaceId], references: [id], onDelete: Cascade)
  createdByUser   UserAccount         @relation("BriefCreatedByUser", fields: [createdByUserId], references: [id], onDelete: Restrict)
  searchResults   BriefSearchResult[]
  // BG4 reverse relations: a Brief may be referenced by zero or
  // more ProjectRequests (and therefore by the Deals that follow
  // accepted ones).
  projectRequests ProjectRequest[]
  deals           Deal[]

  @@index([buyerWorkspaceId, createdAt])
  @@map("project_briefs")
}

// BriefSearchResult records the eligibility-determined recommendations
// the Matchmaker surfaced for a ProjectBrief. Persisted so the buyer
// can re-render the same recommendations without re-running the
// brief, and so the later ProjectRequest step can revalidate against
// the same evidence (the selection must reference an offering that
// surfaced here).
//
// The Matchmaker returns at most 10 eligible sellers (per the
// TalentSearchService contract); we persist all returned results so
// the revalidation step can prove the selected offering appeared in
// this list at brief time. The `matchReason` and coverage counts are
// persisted verbatim — they are factual evidence (matched fields,
// preference atom coverage, query token coverage), never derived from
// relevanceScore.
model BriefSearchResult {
  id                       String @id @default(cuid())
  briefId                  String
  // Deterministic ordering position within the brief result list.
  // 1-based; ties on the bounded score are broken by sellerId asc
  // (TalentSearchService contract).
  resultPosition           Int
  sellerId                 String
  // The marketplace-shaped public seller summary as returned by the
  // search. Persisted as JSON so the buyer can re-render without
  // depending on whether the seller is still eligible.
  sellerSnapshotJson       Json
  // The selected best-matching offering's id and snapshot.
  bestOfferingId           String
  bestOfferingSnapshotJson Json
  // Up to two additional standalone matching offerings that
  // surfaced alongside the best match. Persisted as a JSON array
  // (empty when the seller only had one eligible offering) so the
  // buyer can see the full eligibility evidence without a
  // follow-up search and so the later ProjectRequest step can
  // revalidate against the same context.
  additionalOfferingsJson  Json
  relevanceScore           Float
  matchReason              String
  preferenceCoverageJson   Json?
  textCoverageJson         Json?

  brief ProjectBrief @relation(fields: [briefId], references: [id], onDelete: Cascade)

  @@unique([briefId, resultPosition])
  @@index([briefId])
  @@index([sellerId])
  @@map("brief_search_results")
}

// ---------- Buildathon Golden Slice 2 (BG2): audio discovery samples ----------
//
// Per ticket #61 a ServiceOffering owns zero through three
// `ServiceOfferingAudioSample` records. Each sample is a bounded MP3
// discovery attachment; this is NOT a PortfolioItem, playlist, catalog
// asset, licensed work, or DealDeliverable. PostgreSQL is canonical
// for the metadata (id, owning offering, buyer-facing label, declared
// MIME type, byte size, deterministic display order, opaque storage
// reference). The bounded object bytes live in replaceable external
// storage (Supabase Storage in production; deterministic fixtures in
// tests). Storage credentials, bucket names, and private object keys
// never cross public DTOs.
//
// The display order is owned by the seller (no drag-and-drop, no
// reordering UI), the MIME type is "audio/mpeg" only, and the size is
// capped at 25 MB. The opaque storage reference is the single
// handoff between PostgreSQL and the provider-neutral storage adapter;
// the storage adapter alone can resolve it back to a playable
// reference.
model ServiceOfferingAudioSample {
  id                   String                   @id @default(cuid())
  offeringId           String
  // Buyer-facing title or label rendered in the discovery UI. Allowed
  // length is bounded; the storage adapter never sees this value.
  label                String
  // Declared MIME type. The application enforces audio/mpeg at the
  // trusted boundary; the column captures the value the seller
  // declared at upload time.
  contentType          String
  // Observed byte size. The application enforces the 25 MB cap at
  // the trusted boundary so a seller cannot smuggle a larger file by
  // declaring a smaller content type.
  byteSize             Int
  // Deterministic seller-owned display order. The seller assigns this
  // value at upload time (e.g. "1, 2, 3") so removal + re-upload does
  // not silently re-order the buyer-facing discovery list.
  displayOrder         Int
  // Opaque storage reference handed back by the StorageAdapter. The
  // application treats it as an opaque string; only the adapter that
  // produced it can resolve it back to a playable reference.
  storageRef           String
  // Cleanup lifecycle (ticket #61 follow-up review P1-005). Default
  // `Live`. `PendingCleanup` means the seller removed the sample but
  // the bounded object could not be deleted at provider removal time;
  // the row is preserved so a bounded retry can complete the
  // cleanup. `Removed` is a transient state during the row delete.
  cleanupStatus        AudioSampleCleanupStatus @default(Live)
  // Number of storage-removal attempts that have failed for this
  // row while it is in `PendingCleanup`. Bounded by the application
  // (no generalized retry infrastructure).
  cleanupAttempts      Int                      @default(0)
  // Last cleanup failure timestamp (UTC). Used to surface the most
  // recent provider failure without logging the provider error
  // message.
  cleanupLastFailureAt DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  offering ServiceOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  @@index([offeringId])
  @@index([cleanupStatus])
  @@map("offering_audio_samples")
}

// Audio sample orphaned storage locator.
//
// Per ticket #61 follow-up review (P1-002): when an upload succeeds
// in storage but the DB counterpart never persists (DB write fails or
// the cap guard rejects the row), and the immediate storage-delete
// also fails, the storage reference would otherwise be lost. This
// table is the durable recovery record: a row keyed by `storageRef`
// carries the offering id and a bounded retry counter so the next
// operation against the offering can discover and complete the
// storage-side cleanup. Rows are deleted when the storage-side
// delete confirms success or the storage object is reported
// already-gone.
model AudioSampleOrphanedStorage {
  storageRef           String    @id
  // Owning offering. Used to scope the bounded retry pass and to
  // cascade when the offering is removed.
  offeringId           String
  // Number of storage-removal attempts that have failed for this
  // orphan. Bounded by the application (no generalized retry
  // infrastructure).
  cleanupAttempts      Int       @default(0)
  // Last cleanup failure timestamp (UTC).
  cleanupLastFailureAt DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  offering ServiceOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  @@index([offeringId])
  @@map("audio_sample_orphaned_storage")
}

// ---------- Buildathon Golden Slice 4 (BG4) ----------
//
// ProjectRequest is a buyer Workspace's invitation to a seller
// Workspace to discuss a project. Seller acceptance opens
// negotiation but does not approve terms or activate paid work
// (CONTEXT.md: "ProjectRequest — A buyer Workspace's invitation to a
// seller Workspace to discuss a project. Seller acceptance opens
// negotiation but does not approve terms or activate paid work.").
//
// Required statuses (per ticket #62): `Pending | Accepted | Declined`.
// Pending is the only non-terminal state; Accepted and Declined are
// terminal and cannot be reversed in this slice.
//
// The unique constraint on `projectRequestId` in the Deal table
// prevents retries from creating multiple Deals for one accepted
// ProjectRequest (GS 26). The partial unique index
// `(buyerWorkspaceId, sellerWorkspaceId, serviceOfferingId,
// projectBriefId) WHERE status = 'Pending'` prevents inappropriate
// duplicate Pending ProjectRequests while still allowing the buyer
// to send a follow-up request after a Decline or a closed Deal.
//
// Every consequential reference (buyer / seller Workspace, deciding
// UserAccount, owning ProjectBrief, owning ServiceOffering) uses
// `onDelete: Restrict` so deleting a Workspace, deciding user, or
// referenced record fails closed rather than erasing consent and
// audit evidence. Workspace removal in the buildathon is
// out-of-scope; archival semantics will land in a later ticket.
model ProjectRequest {
  id                     String               @id @default(cuid())
  buyerWorkspaceId       String
  sellerWorkspaceId      String
  serviceOfferingId      String
  projectBriefId         String
  // The acting human who created the request. Recorded for audit;
  // authorization is decided by WorkspaceMembership, not by this
  // column.
  createdByUserId        String
  status                 ProjectRequestStatus @default(Pending)
  // Set the moment the seller accepts OR declines. Null while
  // Pending. Used by the seller inbox to render ordering.
  sellerDecisionAt       DateTime?
  // The acting seller human who issued the decision. Null while
  // Pending. Recorded for audit (the workspace authorization was
  // revalidated at decision time).
  sellerDecisionByUserId String?
  // Set the moment the seller accepts the request. Equivalent to
  // `sellerDecisionAt` when status = Accepted; null otherwise.
  // Persisted as a separate column because it is the canonical
  // "explicit seller consent" evidence referenced by GS 18 and by
  // every future activation invariant.
  sellerConsentAt        DateTime?
  createdAt              DateTime             @default(now())

  buyerWorkspace   Workspace       @relation("BuyerWorkspaceProjectRequests", fields: [buyerWorkspaceId], references: [id], onDelete: Restrict)
  sellerWorkspace  Workspace       @relation("SellerWorkspaceProjectRequests", fields: [sellerWorkspaceId], references: [id], onDelete: Restrict)
  serviceOffering  ServiceOffering @relation(fields: [serviceOfferingId], references: [id], onDelete: Restrict)
  projectBrief     ProjectBrief    @relation(fields: [projectBriefId], references: [id], onDelete: Restrict)
  createdByUser    UserAccount     @relation("ProjectRequestCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  sellerDecisionBy UserAccount?    @relation("ProjectRequestDecidedBy", fields: [sellerDecisionByUserId], references: [id], onDelete: Restrict)

  deal Deal?

  // Partial unique index mirrors
  // `project_requests_pending_unique_idx` created in
  // 20260827090000_bg4_project_requests/migration.sql. The same
  // column list, index name, and `WHERE status = 'Pending'`
  // predicate are preserved here so a future `prisma migrate diff`
  // treats the SQL-created index as expected schema state rather
  // than as drift to reconcile. The `where:` predicate is the
  // partial-index preview feature; the `map:` argument pins the
  // underlying SQL index name. Closing over `status = 'Pending'`
  // — the only non-terminal state — keeps terminal rows from
  // blocking legitimate re-engagement.
  @@unique([buyerWorkspaceId, sellerWorkspaceId, serviceOfferingId, projectBriefId], map: "project_requests_pending_unique_idx", where: { status: "Pending" })
  @@index([buyerWorkspaceId, status, createdAt])
  @@index([sellerWorkspaceId, status, createdAt])
  @@index([serviceOfferingId])
  @@index([projectBriefId])
  @@map("project_requests")
}

// Deal is an accepted commercial engagement between buyer and seller
// Workspaces (CONTEXT.md: "Deal — An accepted commercial engagement
// between buyer and seller Workspaces. It becomes Active only after
// both parties approve the same TermsVersion and escrow funding
// succeeds.").
//
// The BG4 slice creates exactly one Deal in `Negotiating` per accepted
// ProjectRequest; the (projectRequestId) unique constraint prevents
// retries from creating a second Deal (GS 26). Transitions to Active
// are owned by a later ticket (Deal/TermsVersion/approvals) and never
// happen in BG4.
//
// Every consequential reference uses `onDelete: Restrict` so
// deleting the buyer / seller Workspace, the originating
// ProjectRequest, the referenced ProjectBrief, or the referenced
// ServiceOffering fails closed rather than erasing the accepted
// engagement and its audit evidence.
model Deal {
  id                String     @id @default(cuid())
  buyerWorkspaceId  String
  sellerWorkspaceId String
  serviceOfferingId String
  projectBriefId    String
  // Natural uniqueness: exactly one Deal per accepted
  // ProjectRequest. A retried accept on the same already-accepted
  // request cannot create a second row because the unique index
  // fails the insert.
  projectRequestId  String     @unique
  status            DealStatus @default(Negotiating)
  // Set when the deterministic activation invariant transitions the
  // Deal to Active. Always null in BG4 (Active transitions are
  // owned by a later ticket); included now so the column exists
  // when the activation invariant lands.
  activatedAt       DateTime?
  createdAt         DateTime   @default(now())

  buyerWorkspace  Workspace       @relation("BuyerWorkspaceDeals", fields: [buyerWorkspaceId], references: [id], onDelete: Restrict)
  sellerWorkspace Workspace       @relation("SellerWorkspaceDeals", fields: [sellerWorkspaceId], references: [id], onDelete: Restrict)
  serviceOffering ServiceOffering @relation(fields: [serviceOfferingId], references: [id], onDelete: Restrict)
  projectBrief    ProjectBrief    @relation(fields: [projectBriefId], references: [id], onDelete: Restrict)
  projectRequest  ProjectRequest  @relation(fields: [projectRequestId], references: [id], onDelete: Restrict)

  @@index([buyerWorkspaceId, status, createdAt])
  @@index([sellerWorkspaceId, status, createdAt])
  @@map("deals")
}
