{
  "name": "soundhub",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev:web": "pnpm --filter @soundhub/web dev",
    "dev:api": "pnpm --filter @soundhub/api dev",
    "dev": "concurrently -n web,api -c blue,magenta \"pnpm dev:web\" \"pnpm dev:api\"",
    "build": "pnpm prisma:generate && pnpm --filter @soundhub/types build && pnpm --filter @soundhub/db build && pnpm --filter @soundhub/api build && pnpm --filter @soundhub/web build",
    "type-check": "pnpm prisma:generate && pnpm --filter @soundhub/types build && pnpm --filter @soundhub/db build && pnpm --filter @soundhub/api type-check && pnpm --filter @soundhub/web type-check",
    "test": "pnpm --filter @soundhub/api test",
    "test:repository": "pnpm --filter @soundhub/api test:repository",
    "test:e2e": "pnpm --filter @soundhub/web test:e2e",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "pnpm type-check && pnpm lint && pnpm test && pnpm build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prisma:generate": "pnpm --filter @soundhub/db db:generate",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down -v",
    "db:test:up": "docker compose -f docker-compose.test.yml up -d",
    "db:test:down": "docker compose -f docker-compose.test.yml down -v",
    "db:test:wait": "node scripts/wait-for-test-db.mjs",
    "db:test:migrate": "pnpm db:test:wait && pnpm --filter @soundhub/db db:migrate:deploy",
    "db:test:seed": "pnpm --filter @soundhub/db db:seed",
    "db:test:reset": "pnpm db:test:wait && pnpm --filter @soundhub/db db:reset:test"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "concurrently": "^9.0.0",
    "dotenv-cli": "^7.4.2",
    "eslint": "^9.10.0",
    "eslint-config-prettier": "^9.1.2",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.0.0"
  }
}
