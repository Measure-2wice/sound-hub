{
  "name": "soundhub",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev:web": "pnpm --filter @soundhub/web dev",
    "dev:api": "pnpm --filter @soundhub/api dev",
    "dev": "concurrently -n web,api -c blue,magenta \"pnpm dev:web\" \"pnpm dev:api\"",
    "build": "pnpm prisma:generate && pnpm --filter @soundhub/types build && pnpm --filter @soundhub/db build && pnpm --filter @soundhub/api build && pnpm --filter @soundhub/web build",
    "type-check": "pnpm prisma:generate && pnpm --filter @soundhub/types build && pnpm --filter @soundhub/db build && pnpm --filter @soundhub/api type-check && pnpm --filter @soundhub/web type-check",
    "test": "pnpm --filter @soundhub/api test && pnpm --filter @soundhub/web test && pnpm test:repository && pnpm test:forbidden-deps && pnpm test:db-qa-env && pnpm test:multi-workspace-seed",
    "test:repository": "pnpm --filter @soundhub/api test:repository",
    "test:forbidden-deps": "node --test scripts/check-forbidden-deps.test.mjs",
    "test:db-qa-env": "node --test scripts/db-qa-env.test.mjs",
    "test:multi-workspace-seed": "node --test scripts/db-seed-multi-workspace-user.test.mjs",
    "test:e2e": "pnpm --filter @soundhub/web test:e2e",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "pnpm type-check && pnpm lint && pnpm test && pnpm build",
    "check:fast": "pnpm format:check && pnpm type-check && pnpm --filter @soundhub/api test && pnpm --filter @soundhub/web test && pnpm test:forbidden-deps && pnpm test:db-qa-env && pnpm test:multi-workspace-seed",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prisma:generate": "pnpm --filter @soundhub/db db:generate",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down -v",
    "db:test:up": "docker compose -f docker-compose.test.yml up -d",
    "db:test:down": "docker compose -f docker-compose.test.yml down -v",
    "db:test:wait": "apps/api/node_modules/.bin/tsx scripts/wait-for-test-db.mjs",
    "db:test:reset": "pnpm db:test:wait && apps/api/node_modules/.bin/tsx scripts/db-test-reset.mjs",
    "db:test:migrate": "pnpm db:test:wait && apps/api/node_modules/.bin/tsx scripts/db-test-migrate.mjs",
    "db:test:seed": "apps/api/node_modules/.bin/tsx scripts/db-test-seed.mjs",
    "db:test:cycle": "apps/api/node_modules/.bin/tsx scripts/db-test-cycle.mjs",
    "db:qa:wait": "apps/api/node_modules/.bin/tsx scripts/db-qa-wait.mjs",
    "db:qa:migrate": "pnpm db:qa:wait && apps/api/node_modules/.bin/tsx scripts/db-qa-migrate.mjs",
    "db:qa:seed": "pnpm db:qa:wait && apps/api/node_modules/.bin/tsx scripts/db-qa-seed.mjs",
    "dev:qa": "apps/api/node_modules/.bin/tsx scripts/dev-qa.mjs",
    "check:forbidden-deps": "node scripts/check-forbidden-deps.mjs",
    "acceptance-gate": "node scripts/acceptance-gate.mjs",
    "clean": "rm -rf apps/web/.next apps/web/.next-dev packages/*/dist packages/*/tsconfig.tsbuildinfo packages/db/src/generated",
    "clean:build": "pnpm clean && pnpm prisma:generate && pnpm build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yml,yaml,css,scss}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^9.2.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "prettier": "^3.3.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.0.0"
  }
}
