{
  "name": "soundhub",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev:web": "pnpm --filter @soundhub/web dev",
    "dev:api": "pnpm --filter @soundhub/api dev",
    "dev": "concurrently -n web,api -c blue,magenta \"pnpm dev:web\" \"pnpm dev:api\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prisma:generate": "pnpm --filter @soundhub/db prisma generate",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down -v"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "concurrently": "^9.0.0",
    "eslint": "^9.10.0",
    "eslint-config-prettier": "^9.1.2",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^7.18.0"
  }
}
