# Root environment file - copy to .env for local development

# Developer database (NOT used by M1.1 tests; the disposable test database below is)
DATABASE_URL="postgresql://soundhub:password@localhost:5432/soundhub_db"

# Disposable test database. The database name must end in `_test` and the host must
# be local/Compose. The test harness fails closed when those conditions are not met.
TEST_DATABASE_URL="postgresql://soundhub:password@localhost:5433/soundhub_m1_test"

# Manual-QA database. Distinct from the destructive test target above so a
# repository-test reset cannot drop tables a running QA session depends on. The
# dev API server reads QA_DATABASE_URL via `pnpm dev:qa`, which exports it as
# DATABASE_URL before launching the API. The test harness refuses to run
# destructive scripts against this database (apps/api/src/lib/test-database.ts).
# The container's docker-entrypoint-initdb.d hook creates `soundhub_qa` on the
# first startup of an empty data directory; subsequent restarts preserve any
# migrated state.
QA_DATABASE_URL="postgresql://soundhub:password@localhost:5433/soundhub_qa"

# Development Configuration
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:4000

PUBLIC_API_BASE_URL=http://localhost:3000

# Highrise × Impala Matchmaker provider
IMPALA_BASE_URL=https://ht.getimpala.ai/v1
IMPALA_API_KEY=
IMPALA_MODEL=qwen3.6-27b