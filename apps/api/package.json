{
  "name": "@soundhub/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "type-check": "tsc --noEmit",
    "test": "node --import tsx --test src/services/talent-search.service.test.ts src/lib/enum-drift.test.ts src/lib/test-database.test.ts src/routes/search.test.ts",
    "test:repository": "node --import tsx --test src/repositories/prisma-talent-search.repository.test.ts"
  },
  "dependencies": {
    "express": "^4.19.0",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "dotenv": "^16.4.0",
    "zod": "^3.23.8",
    "@soundhub/types": "workspace:*",
    "@soundhub/db": "workspace:*"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/cors": "^2.8.0",
    "@types/node": "^20.16.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
