{
  "name": "@soundhub/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "type-check": "tsc --noEmit",
    "test": "TEST_DATABASE_URL=postgresql://soundhub:password@localhost:5433/soundhub_m1_test node --import tsx --test src/services/talent-search.service.test.ts src/lib/enum-drift.test.ts src/lib/test-database.test.ts src/routes/search.test.ts src/routes/metadata.test.ts",
    "test:repository": "TEST_DATABASE_URL=postgresql://soundhub:password@localhost:5433/soundhub_m1_test node --import tsx --test src/repositories/prisma-talent-search.repository.test.ts",
    "test:db": "TEST_DATABASE_URL=postgresql://soundhub:password@localhost:5433/soundhub_m1_test tsx ../../packages/db/prisma/seed.test.ts",
    "test:db:m2": "TEST_DATABASE_URL=postgresql://soundhub:password@localhost:5433/soundhub_m1_test tsx ../../packages/db/prisma/m2-foundation.test.ts",
    "test:db:m2:transition": "TEST_DATABASE_URL=postgresql://soundhub:password@localhost:5433/soundhub_m1_test tsx ../../packages/db/prisma/m2-foundation-transition.test.ts",
    "test:full": "npm run test:db && npm run test:db:m2:transition && npm run test:db:m2 && npm run test:repository"
  },
  "dependencies": {
    "express": "^4.19.0",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "dotenv": "^16.4.0",
    "zod": "^3.23.8",
    "content-type": "^1.0.5",
    "@soundhub/types": "workspace:*",
    "@soundhub/db": "workspace:*"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/cors": "^2.8.0",
    "@types/node": "^20.16.0",
    "@types/supertest": "^6.0.2",
    "@types/content-type": "^1.1.5",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
