# Database
DATABASE_URL="postgresql://soundhub:password@localhost:5432/soundhub_db"

# Server Configuration
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# AI Services (for future implementation)
OPENAI_API_KEY=your_openai_api_key_here
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=soundhub-producers

# AWS S3 (for future music file uploads)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=soundhub-music-files
AWS_REGION=us-east-1